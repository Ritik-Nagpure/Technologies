pipeline {
    agent any
    stages {
        stage('Stage 1') {
            steps {
                sh 'echo This is Stage 1'
            }
        }

        stage('Stage 2') {
            steps {
                sh 'echo This is Stage 2 && exit 0'
            }
        }

        stage('Stage 3') {
            steps {
                sh 'echo "This is Stage 3" && exit 0'
            }
        }

        stage('Stage 4') {
            steps {
                sh 'echo "This is Stage 4" && exit 0'
            }
        }

        stage('Stage 5') {
            steps {
                sh 'echo "This is Stage 5" && exit 0'
            }
        }
    }
}
